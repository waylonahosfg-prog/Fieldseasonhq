---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGearForState } from '../data/gearCatalog';
import { slugifySpecies, formatEvergreenStatus } from '../utils/formatters';

export function getStaticPaths() {
  const files = import.meta.glob('../data/states/*.json', { eager: true, import: 'default' });
  return Object.values(files).map((state: any) => ({ params: { slug: state.slug }, props: { state } }));
}
const { state } = Astro.props;
const title = `${state.name} Hunting Season Dates 2026 | Field Season HQ`;
const canonical = `https://fieldseasonhq.com/${state.slug}/`;
const agency = state.agency;
const seasonFacts = state.seasonFacts || [];
const speciesGroups = [...new Set(seasonFacts.map((fact: any) => fact.species))];
const allLicenseFacts = state.licenseAndEducation || [];
const isEducation = (fact: any) => /education|mentored|youth/i.test(fact.topic);
const licenseFacts = allLicenseFacts.filter((fact: any) => !isEducation(fact));
const educationFacts = allLicenseFacts.filter(isEducation);
const deadlines = state.deadlines || [];
const sources = state.sources || [];
const unverified = state.unverifiedItems || [];
const gear = getGearForState(state);
const inlineGear = gear.slice(0, 2);
const stateFiles = import.meta.glob('../data/states/*.json', { eager: true, import: 'default' });
const related = Object.values(stateFiles).map((item: any) => item).filter((item: any) => item.slug !== state.slug).sort((a: any, b: any) => a.sortOrder - b.sortOrder);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fieldseasonhq.com/' },
    { '@type': 'ListItem', position: 2, name: state.name, item: canonical }
  ]
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${state.name} Hunting Season Dates 2026–2027`,
  description: state.metaDescription,
  url: canonical,
  dateModified: state.verifiedOn,
  publisher: {
    '@type': 'Organization',
    name: 'Field Season HQ',
    url: 'https://fieldseasonhq.com/'
  }
};
---
<BaseLayout title={title} description={state.metaDescription} canonical={canonical} structuredData={[breadcrumbSchema, webPageSchema]}>
  <section class="state-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">{state.name}</li></ol></nav>
      <span class="eyebrow">{state.year || '2026–27'} season guide</span>
      <h1>{state.name} Hunting Season Dates 2026–2027</h1>
      <p>{state.intro}</p>
      <div class="state-meta">
        <span>Official agency: <a href={agency.url} target="_blank" rel="noopener noreferrer">{agency.name} ↗</a></span>
        <span>Last verified: <time datetime={state.verifiedOn}>{state.verifiedOn}</time></span>
      </div>
      <nav class="quick-links" aria-label="On this page">
        <a href="#seasons">Season dates</a><a href="#license">License steps</a><a href="#education">Hunter ed</a><a href="#deadlines">Draw deadlines</a><a href="#gear">Field gear</a>
      </nav>
    </div>
  </section>

  <section class="container content-section" id="seasons">
    <span class="section-kicker">2026–27 dates</span>
    <h2>Hunting seasons by species and method</h2>
    <p class="lead">Statewide summaries for the 2026–27 hunting season. Select any species heading for its dedicated guide, and always confirm exact unit rules in the linked official agency regulations.</p>
    {speciesGroups.map((species: any, idx: number) => <>
      <section class="species-block" aria-label={`${species} season dates`}>
        <div class="species-header">
          <h3><a href={`/${state.slug}/${slugifySpecies(species)}/`}>{species}</a></h3>
          <span class="scroll-hint" aria-hidden="true">Swipe table →</span>
        </div>
        <div class="table-wrap" role="region" aria-label={`${species} season table; scroll horizontally on small screens`} tabindex="0">
          <table class="season-table">
            <thead><tr><th scope="col">Season / method</th><th scope="col">Dates</th><th scope="col">Season window</th><th scope="col">Area &amp; exceptions</th><th scope="col">Source</th></tr></thead>
            <tbody>{seasonFacts.filter((fact: any) => fact.species === species).map((fact: any) => <tr>
              <td>{fact.method}</td><td>{fact.dates}</td><td>{formatEvergreenStatus(fact.status)}</td>
              <td>{fact.scopeAndExceptions}{fact.additionalRule ? ` ${fact.additionalRule}` : ''}</td>
              <td><a class="source-link" href={fact.sourceUrl} target="_blank" rel="noopener noreferrer">Official source ↗</a><br /><small>Verified {fact.verifiedOn}</small></td>
            </tr>)}</tbody>
          </table>
        </div>
      </section>
      {idx === 0 && inlineGear.length > 0 && (
        <aside class="inline-gear-box" aria-label="Recommended field gear">
          <div class="inline-gear-head">
            <span class="inline-gear-badge">Field Checklist</span>
            <span class="small">As an Amazon Associate I earn from qualifying purchases.</span>
          </div>
          <div class="inline-gear-list">
            {inlineGear.map((item) => (
              <div class="inline-gear-item">
                <div>
                  <strong>{item.name}</strong>
                  <p>{item.whyUseful}</p>
                </div>
                <a href={item.url} rel="sponsored nofollow noopener" target="_blank">Check on Amazon ↗</a>
              </div>
            ))}
          </div>
        </aside>
      )}
    </>)}
    {state.zoneNote && <div class="notice"><p><strong>Unit and zone note:</strong> {state.zoneNote}</p></div>}
  </section>

  <section class="container content-section" id="license">
    <span class="section-kicker">Before you go</span><h2>How to get a hunting license</h2>
    <p class="lead">Confirm your hunt, eligibility and required authorizations, then use the official sales channel. Check the listed fees and current availability before purchase.</p>
    <ol class="steps">{licenseFacts.map((fact: any) => <li>
      <span class="fact-title">{fact.topic}</span><span>{fact.fact}</span>
      <a class="fact-source" href={fact.sourceUrl} target="_blank" rel="noopener noreferrer">Official source ↗ <span class="small">(verified {fact.verifiedOn})</span></a>
    </li>)}</ol>
  </section>

  <section class="container content-section" id="education">
    <span class="section-kicker">Learn first</span><h2>Hunter education requirements</h2>
    {educationFacts.length ? <ul class="fact-list">{educationFacts.map((fact: any) => <li>
      <span class="fact-title">{fact.topic}</span><span>{fact.fact}</span>
      <a class="fact-source" href={fact.sourceUrl} target="_blank" rel="noopener noreferrer">Official source ↗ <span class="small">(verified {fact.verifiedOn})</span></a>
    </li>)}</ul> : <p>Not yet published - check {agency.name}.</p>}
  </section>

  <section class="container content-section" id="deadlines">
    <span class="section-kicker">Plan ahead</span><h2>Draw and application deadlines</h2>
    <ul class="fact-list">{deadlines.map((item: any) => <li>
      <span class="fact-title">{item.applicationOrDeadline}</span><span>{item.dateOrStatus} {item.relevantYear ? `(${item.relevantYear})` : ''}</span>
      <a class="fact-source" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">Official source ↗ <span class="small">(verified {item.verifiedOn})</span></a>
    </li>)}</ul>
  </section>

  <section class="container content-section" id="gear">
    <span class="section-kicker">Field kit</span><h2>Recommended {state.name} hunting gear</h2>
    <p class="small affiliate-note">As an Amazon Associate I earn from qualifying purchases.</p>
    <div class="gear-grid">{gear.map((item) => <div class="gear-card">
      <span class="gear-cat">{item.category}</span>
      <h3>{item.name}</h3><p>{item.whyUseful}</p>
      <a href={item.url} rel="sponsored nofollow noopener" target="_blank">View on Amazon ↗</a>
      <p class="small">Amazon listing verified {item.verifiedOn}. Price and availability are shown by Amazon.</p>
    </div>)}</div>
  </section>

  <section class="container content-section" id="sources">
    <span class="section-kicker">Check the rules</span><h2>Official sources</h2>
    <p class="lead">Use the relevant agency publication for your exact hunt. Each season, license and deadline fact above has its own source and verification date.</p>
    <ul class="fact-list">{sources.map((source: any) => <li>
      <span class="fact-title">{source.category}: {source.title}</span>
      <a class="fact-source source-url" href={source.url} target="_blank" rel="noopener noreferrer">{source.url} ↗</a><small>Verified {source.verifiedOn}</small>
    </li>)}</ul>
    {unverified.length > 0 && <div class="notice"><h3>Items to confirm</h3><ul>{unverified.map((item: string) => <li>{item}</li>)}</ul></div>}
  </section>

  <section class="container content-section">
    <div class="callout"><h2>Before you hunt</h2>
      <p>Regulations change. Always confirm with <a href={agency.url} target="_blank" rel="noopener noreferrer">{agency.name}</a> before you hunt.</p>
      <p class="last-verified">Last verified: {state.verifiedOn}</p>
    </div>
    <nav class="related-guides" aria-label="Related state guides"><h2>Explore other state guides</h2><ul>{related.map((item: any) => <li><a href={`/${item.slug}/`}>{item.name} hunting dates</a></li>)}</ul><a href="/">Back to all states →</a></nav>
  </section>
</BaseLayout>
