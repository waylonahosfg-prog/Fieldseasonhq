---
import BaseLayout from '../layouts/BaseLayout.astro';
import { slugifySpecies } from '../utils/formatters';

const stateModules = import.meta.glob('../data/states/*.json', { eager: true, import: 'default' });
const states = Object.values(stateModules).map((item: any) => item).sort((a: any, b: any) => a.sortOrder - b.sortOrder);
const reviewedOn = states.map((state: any) => state.verifiedOn).sort().at(-1) || '2026-11-22';
const totalSpeciesPages = states.reduce((acc: number, s: any) => acc + new Set((s.seasonFacts || []).map((f: any) => f.species)).size, 0);

const STATE_ABBR: Record<string, string> = {
  colorado: 'CO',
  michigan: 'MI',
  pennsylvania: 'PA',
  texas: 'TX',
  wisconsin: 'WI'
};

const title = 'Field Season HQ | 2026–2027 State Hunting Season Dates & Rules';
const description = 'Verified 2026–2027 hunting season dates, license requirements, hunter education rules, draw deadlines, and official wildlife agency citations by state.';
const canonical = 'https://fieldseasonhq.com/';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Field Season HQ',
  url: canonical,
  description
};
---
<BaseLayout title={title} description={description} canonical={canonical} structuredData={websiteSchema}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">2026–2027 State Hunting Reference</span>
        <h1>Verified Hunting Season Dates &amp; Field Basics by State</h1>
        <p>Fast, source-cited 2026–2027 season windows, license steps, hunter education rules, and application deadlines—linked directly to official state wildlife agencies.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#states">Browse State Guides</a>
          <a class="btn btn-secondary" href="/about/">How We Verify Data</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="Coverage snapshot">
        <h2>Coverage Snapshot</h2>
        <ul>
          <li><span>States covered</span><strong>{states.length} Priority States</strong></li>
          <li><span>Species guides</span><strong>{totalSpeciesPages}+ Dedicated Pages</strong></li>
          <li><span>Season cycle</span><strong>2026–2027</strong></li>
          <li><span>Citations</span><strong>100% Official Agency Links</strong></li>
          <li><span>Last reviewed</span><strong>{reviewedOn}</strong></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section" id="states">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">Choose a state</span>
        <h2>2026–2027 State Hunting Season Guides</h2>
        <p>Select a state for complete statewide species tables, license steps, draw deadlines, and field gear checklists.</p>
      </div>
      <div class="state-grid">
        {states.map((state: any) => {
          const speciesCount = new Set((state.seasonFacts || []).map((f: any) => f.species)).size;
          const popularSpecies = [...new Set((state.seasonFacts || []).map((f: any) => f.species))].slice(0, 3) as string[];
          const badge = state.abbreviation || STATE_ABBR[state.slug] || state.slug.slice(0, 2).toUpperCase();
          return (
            <article class="state-card">
              <div>
                <div class="card-top">
                  <span class="state-badge">{badge}</span>
                  <span class="verified-chip">Verified {state.verifiedOn}</span>
                </div>
                <h3><a href={`/${state.slug}/`}>{state.name} Hunting Seasons</a></h3>
                <p>{state.metaDescription}</p>
                <div class="card-meta">
                  <span><strong>Agency:</strong> {state.agency.name}</span>
                  <span><strong>Coverage:</strong> {speciesCount} species guides ({popularSpecies.join(', ')})</span>
                </div>
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center;justify-content:space-between;">
                <a class="card-link" href={`/${state.slug}/`}>Open {state.name} guide →</a>
                {popularSpecies[0] && (
                  <a class="small" href={`/${state.slug}/${slugifySpecies(popularSpecies[0])}/`}>{popularSpecies[0]} dates →</a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">Built for the field</span>
        <h2>What Every State &amp; Species Guide Includes</h2>
        <p>No bloated blog filler—just structured regulatory facts, direct official PDFs, and practical gear checklists.</p>
      </div>
      <div class="info-grid">
        <div class="info-card">
          <h3>Method-Specific Windows</h3>
          <p>Archery, muzzleloader, firearm, and youth dates separated cleanly with zone and unit exception notes.</p>
        </div>
        <div class="info-card">
          <h3>Direct Agency Citations</h3>
          <p>Every season row, license rule, and draw deadline links straight to the governing state wildlife agency source.</p>
        </div>
        <div class="info-card">
          <h3>License &amp; Hunter Ed Steps</h3>
          <p>Clear breakdowns of resident/non-resident licensing portals, carcass tagging rules, and hunter safety thresholds.</p>
        </div>
        <div class="info-card">
          <h3>Species-Matched Field Gear</h3>
          <p>Targeted equipment checklists—from blaze orange compliance kits to quartering game bags and waterproof tag holders.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
